{
  "model": "claude-sonnet-5-5",
  "permissions": {
    "allow": [
      "Bash(node atcctl.mjs *)",
      "Bash(node /home/c10/projects/atc/controller/atcctl.mjs *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/c10/.nvm/versions/node/v24.19.0/bin/node\" \"$CLAUDE_PROJECT_DIR/guard.mjs\" || exit 2",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/c10/.nvm/versions/node/v24.19.0/bin/node\" \"$CLAUDE_PROJECT_DIR/squelch.mjs\" tower",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
