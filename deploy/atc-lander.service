[Unit]
Description=atc SELF-LANDING lander (docs/self-landing.md)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/c10/projects/atc
# node·npm(nvm)과 gh·git. user service는 셸 프로필을 읽지 않는다
Environment="PATH=/home/c10/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/c10/.nvm/versions/node/v24.19.0/bin/node deploy/lander.mjs
# 로컬 확인(테스트·tsc·빌드)이 PR마다 1분 안팎
TimeoutStartSec=20min
