{
  "permissions": {
    "allow": [
      "Bash(node ../controller/atcctl.mjs *)",
      "Bash(node /home/c10/projects/atc/controller/atcctl.mjs *)",
      "Bash(jq *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit"
    ],
    "additionalDirectories": [
      "../docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/c10/.nvm/versions/node/v24.19.0/bin/node\" \"$CLAUDE_PROJECT_DIR/../controller/guard.mjs\" --gh-read || exit 2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/c10/.nvm/versions/node/v24.19.0/bin/node\" \"$CLAUDE_PROJECT_DIR/mcp-guard.mjs\" || exit 2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/c10/.nvm/versions/node/v24.19.0/bin/node\" \"$CLAUDE_PROJECT_DIR/send-guard.mjs\" || exit 2",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
